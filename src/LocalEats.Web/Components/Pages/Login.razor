@page "/login"
@using LocalEats.Application.Users
@inject LoginService LoginService
@inject ILogger<Login> Logger

<PageTitle>Sign in | LocalEats</PageTitle>

<main class="auth-page">
    <a href="/">LocalEats</a>
    <h1>Sign in</h1>
    @if (failed)
    {
        <p role="alert">Unable to sign in. Check your details or try again later.</p>
    }
    <EditForm Model="Input" OnValidSubmit="SignInAsync" FormName="login" Enhance="false">
        <DataAnnotationsValidator />
        <div role="alert"><ValidationSummary /></div>
        <label for="login-email">Email address</label>
        <InputText id="login-email" type="email" @bind-Value="Input.Email" autocomplete="username" maxlength="254" />
        <ValidationMessage For="() => Input.Email" />
        <label for="login-password">Password</label>
        <InputText id="login-password" type="password" @bind-Value="Input.Password" autocomplete="current-password" maxlength="128" />
        <ValidationMessage For="() => Input.Password" />
        <label class="remember"><InputCheckbox @bind-Value="Input.RememberMe" /> Keep me signed in on this device</label>
        <button type="submit">Sign in</button>
    </EditForm>
    <p><a href="/register">Create an account</a></p>
</main>

@code {
    [SupplyParameterFromForm]
    public LoginRequest Input { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private bool failed;

    public Login() => Input = new LoginRequest();

    protected override void OnInitialized() => Input ??= new LoginRequest();

    private async Task SignInAsync()
    {
        try
        {
            if (await LoginService.SignInAsync(Input))
            {
                HttpContext?.Response.Redirect(ReturnUrlPolicy.Normalize(ReturnUrl));
                return;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError("Sign-in failed with error type {ErrorType}.", exception.GetType().Name);
        }
        finally
        {
            Input.Password = string.Empty;
        }

        failed = true;
    }
}
