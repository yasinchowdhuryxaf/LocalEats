@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <div class="page-container header-row">
        <a class="wordmark" href="/" aria-label="LocalEats home">LocalEats<span>Good food, close to home.</span></a>
        <nav class="desktop-nav" aria-label="Main navigation"><NavigationLinks /></nav>
        <details class="mobile-nav">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation"><NavigationLinks /></nav>
        </details>
    </div>
</header>
<main id="main-content" class="page-container page-content" tabindex="-1">
    @Body
</main>
<footer class="site-footer">
    <div class="page-container footer-row"><span>LocalEats · Your neighborhood table</span><a href="/">Home</a></div>
</footer>
<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. Please reload the page.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
