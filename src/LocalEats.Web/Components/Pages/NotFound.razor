@page "/not-found"
@layout MainLayout
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>@Heading | LocalEats</PageTitle>
<section class="auth-page">
    <h1>@Heading</h1>
    <p>This page is not available. Browse the restaurant directory to find another restaurant.</p>
    <a href="/restaurants">Browse restaurants</a>
</section>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string OriginalPath => HttpContext?.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath
        ?? HttpContext?.Request.Path.Value ?? string.Empty;
    private string Heading => OriginalPath.StartsWith("/restaurants/", StringComparison.OrdinalIgnoreCase)
        ? "Restaurant not found" : OriginalPath.StartsWith("/orders/", StringComparison.OrdinalIgnoreCase) ? "Order not found" : "Page not found";
}
