@page "/manager/restaurant"
@page "/manager/menu"
@page "/manager/orders"
@using Microsoft.AspNetCore.Authorization
@using LocalEats.Application.Security
@attribute [Authorize(Policy = RolePolicies.Manager)]

<PageTitle>@Title | LocalEats</PageTitle>
<section class="auth-page">
    <h1>@Title</h1>
    <p>@Description</p>
    <p>These tools are not available yet. No restaurant or order data is displayed or changed here.</p>
    <a href="/manager">Back to manager dashboard</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Title => HttpContext?.Request.Path.Value switch
    {
        "/manager/menu" => "Menu management is coming soon",
        "/manager/orders" => "Order management is coming soon",
        _ => "Restaurant setup is coming soon"
    };

    private string Description => HttpContext?.Request.Path.Value switch
    {
        "/manager/menu" => "Menu editing will be connected after restaurant assignments are implemented.",
        "/manager/orders" => "Incoming orders will be connected after restaurant assignments are implemented.",
        _ => "Restaurant setup and assignment checks will be connected in a later project phase."
    };
}
