@using LocalEats.Application.Basket
@inject BasketService Basket
@using LocalEats.Application.Security

<a href="/">Home</a>
<a href="/restaurants">Restaurants</a>
@if (HttpContext?.User.Identity?.IsAuthenticated == true)
{
    @if (HttpContext.User.IsInRole(RoleNames.Customer))
    {
        <a href="/dashboard">Dashboard</a>
    }
    @if (HttpContext.User.IsInRole(RoleNames.Manager))
    {
        <a href="/manager">Manager area</a>
    }
    @if (HttpContext.User.IsInRole(RoleNames.Admin))
    {
        <a href="/admin">Admin area</a>
    }
    <a href="/account">My account</a>
    <a href="/logout">Sign out</a>
}
else
{
    <a href="/login">Sign in</a>
    <a href="/register">Create account</a>
}
<span class="basket-count" aria-label="Basket item count">Basket (@Basket.Snapshot().ItemCount)</span>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
