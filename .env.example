# LocalEats environment template
# Copy values into local user secrets or your shell environment. Never commit real secrets.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=localeats;Username=localeats;Password=localeats_dev_password

# Application URLs
LocalEats__WebBaseUrl=http://localhost:5015
LocalEats__ApiBaseUrl=http://localhost:5253

